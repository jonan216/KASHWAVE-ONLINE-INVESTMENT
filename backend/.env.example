# ==============================================================================
# KashWave Platform — Environment Variables Template
# Copy to .env and fill in REAL values before deploying.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Security Secrets (generate with: node -e "require('crypto').randomBytes(64).toString('hex')")
JWT_SECRET=your_super_secret_jwt_key_here_minimum_64_chars
REFRESH_SECRET=your_super_secret_jwt_refresh_key_here_minimum_64_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Database — PostgreSQL ────────────────────────────────────────────────────
# Option 1: Use full connection URL (Render, Railway, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/kashwave_db

# Option 2: Individual fields (local PostgreSQL)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=kashwave_db
# PGUSER=postgres
# PGPASSWORD=your_postgres_password

# ─── Supabase (HTTP fallback for serverless/Vercel IPv4-only envs) ─────────────
# When set, the backend uses Supabase REST API instead of direct TCP
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ─── Email (Nodemailer SMTP) ──────────────────────────────────────────────────
# Use Gmail app passwords or a transactional email service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# ─── Payment Providers ────────────────────────────────────────────────────────
# Webhook signature secret (generate a strong random key)
PAYMENT_WEBHOOK_SECRET=your_strong_webhook_secret_key_here

# Payment Provider (Marz Innovations)
PAYMENT_PROVIDER_NAME=Marz Innovations
PAYMENT_PROVIDER_EMAIL=your_provider_email@example.com
PAYMENT_PROVIDER_PHONE=+256771178213

# MTN Mobile Money (Uganda)
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox

# Airtel Money (Uganda)
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_ENVIRONMENT=sandbox

# ─── Welcome Bonus ─────────────────────────────────────────────────────────────
# Automatically credited to new users on registration/first login
WELCOME_BONUS_AMOUNT=0

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
SENTRY_DSN=
